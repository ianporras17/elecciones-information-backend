generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  LINK
  VIDEO
  DOCUMENT
}

enum TopicType {
  HEALTH
  WORK
  SECURITY
  EDUCATION
  ECONOMY
  ENVIRONMENT
  OTHER
}

enum Role {
  ADMIN
  USER
}

enum TournamentStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

/**
 * =========================
 * USERS
 * =========================
 */

enum RoomMemberRole {
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(120)
  email        String       @unique @db.VarChar(180)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         Role         @default(USER)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  tournaments  Tournament[]
  memberships  RoomMember[]

  @@map("users")
}

model Room {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(200)
  accessCode  String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topics      Topic[]
  members     RoomMember[]
  tournaments Tournament[]
  candidates  Candidate[]

  @@map("rooms")
}

model RoomMember {
  id       String         @id @default(uuid()) @db.Uuid
  roomId   String         @map("room_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     RoomMemberRole @default(MEMBER)
  joinedAt DateTime       @default(now()) @map("joined_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model Topic {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  title     String   @db.VarChar(200)
    topicType TopicType @default(OTHER) @map("topic_type")
  content   String?  @db.Text
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room        Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resources   ExternalResource[]
  contents    TopicContent[]
  tournaments Tournament[]
  proposals   CandidateProposal[]

  @@index([roomId])
  @@map("topics")
}

/**
 * =========================
 * CONTENIDO POR TEMA Y PARTICIPANTE
 * =========================
 */

model TopicContent {
  id            String   @id @default(uuid()) @db.Uuid
  topicId       String   @map("topic_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, participantId])
  @@index([topicId])
  @@map("topic_contents")
}

/**
 * =========================
 * EXTERNAL RESOURCES
 * =========================
 */

model ExternalResource {
  id          String       @id @default(uuid()) @db.Uuid
  topicId     String       @map("topic_id") @db.Uuid
  type        ResourceType
  title       String       @db.VarChar(200)
  url         String       @db.VarChar(800)
  description String?      @db.Text
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("external_resources")
}

/**
 * =========================
 * TOURNAMENTS
 * =========================
 */

model Tournament {
  id        String           @id @default(uuid()) @db.Uuid
  roomId    String           @map("room_id") @db.Uuid
  topicId   String           @map("topic_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    TournamentStatus @default(IN_PROGRESS)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  room    Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  topic   Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches TournamentMatch[]

  @@index([roomId])
  @@index([topicId])
  @@index([userId])
  @@map("tournaments")
}

model TournamentMatch {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @map("tournament_id") @db.Uuid

  optionAId    String   @map("option_a") @db.Uuid
  optionBId    String   @map("option_b") @db.Uuid
  winnerId     String?  @map("winner") @db.Uuid

  round        Int      @default(1)
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Relaciones a Candidate (3 relaciones distintas)
  optionA   Candidate @relation("match_optionA", fields: [optionAId], references: [id])
  optionB   Candidate @relation("match_optionB", fields: [optionBId], references: [id])
  winner    Candidate? @relation("match_winner", fields: [winnerId], references: [id])

  @@index([tournamentId])
  @@map("tournament_matches")
}

model Candidate {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room           Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposals      CandidateProposal[]
  matchesAsOptionA TournamentMatch[] @relation("match_optionA")
  matchesAsOptionB TournamentMatch[] @relation("match_optionB")
  matchesAsWinner  TournamentMatch[] @relation("match_winner")

  @@index([roomId])
  @@map("candidates")
}

model CandidateProposal {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  topicId     String   @map("topic_id") @db.Uuid
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  topic       Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([candidateId, topicId])
  @@index([topicId])
  @@map("candidate_proposals")
}